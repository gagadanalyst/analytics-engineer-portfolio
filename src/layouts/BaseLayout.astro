---
import '../styles/global.css';
import '../styles/dashboard-blue-theme.css';

// Props let each page supply its own title and description while sharing the same HTML shell.
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Gagandeep Singh | Analytics Engineer',
  description = 'Analytics Engineering portfolio: reliable, testable data products from ingestion to analytics.',
} = Astro.props;

const pageTitle = title.includes('Gagandeep Singh')
  ? title
  : `${title} | Gagandeep Singh`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7F7JW7LG51"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-7F7JW7LG51");
    </script>
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="site-name" href={import.meta.env.BASE_URL} aria-label="Gagandeep Singh home">
          Gagandeep Singh
          <span>Analytics Engineer · Toronto</span>
        </a>
        <div class="header-controls">
          <nav aria-label="Main navigation">
            <a href={`${import.meta.env.BASE_URL}#evidence`}>Work</a>
            <a href={`${import.meta.env.BASE_URL}#writing`}>Writing</a>
            <a href="https://github.com/gagadanalyst" target="_blank" rel="noreferrer">GitHub ↗</a>
          </nav>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} Gagandeep Singh</span>
        <a href="https://github.com/gagadanalyst" target="_blank" rel="noreferrer">GitHub profile ↗</a>
      </div>
    </footer>
  </body>
</html>
