---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectThumbnail from '../../components/ProjectThumbnail.astro';

// For a static site, getStaticPaths tells Astro which project URLs to generate.
export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;

const resources = [
  { label: 'Repository', href: data.repositoryUrl },
  { label: 'Notebook', href: data.notebookUrl },
  { label: 'dbt documentation', href: data.dbtDocsUrl },
  { label: 'Live dashboard', href: data.dashboardUrl },
  { label: 'Power BI report file', href: data.reportUrl },
].filter((resource): resource is { label: string; href: string } => typeof resource.href === 'string');
---
<BaseLayout title={data.title} description={data.description}>
  <article class="project-page container">
    <a class="back-link" href={`${import.meta.env.BASE_URL}#evidence`}>← Back to portfolio</a>

    <header class="project-header">
      <p class="eyebrow">{data.status === 'flagship' ? 'Flagship project' : data.status === 'supporting' ? 'Supporting project' : 'Project backlog'}</p>
      <h1>{data.title}</h1>
      <p class="project-description">{data.description}</p>
      {data.thumbnail && data.thumbnailAlt && (
        <ProjectThumbnail src={data.thumbnail} darkSrc={data.thumbnailDark} alt={data.thumbnailAlt} loading="eager" className="case-study-thumbnail" />
      )}
      {data.technologies.length > 0 && (
        <ul class="technology-list" aria-label="Technologies used">
          {data.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      )}
    </header>

    <div class="project-layout">
      <div class="prose">
        <Content />
      </div>
      <aside class="resource-panel" aria-label="Project resources">
        <h2>Review the evidence</h2>
        <ul>
          {resources.map((resource) => (
            <li><a href={resource.href} target="_blank" rel="noreferrer">{resource.label} ↗</a></li>
          ))}
        </ul>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .project-page { padding-top: 44px; padding-bottom: 88px; }
  .back-link { display: inline-block; color: var(--ink); font-weight: 650; text-decoration: none; text-decoration-color: var(--accent); margin-bottom: 30px; }
  .back-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .project-header { max-width: 820px; margin-bottom: 40px; }
  .project-header :global(.case-study-thumbnail) { max-width: 760px; margin-top: 24px; }
  .eyebrow { color: var(--ink); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; margin: 0 0 16px; }
  h1 { font-size: clamp(2.05rem, 4.5vw, 3.4rem); font-weight: 650; letter-spacing: -0.06em; line-height: 1.06; margin: 0 0 20px; }
  .project-description { color: var(--muted); font-size: 1.15rem; line-height: 1.8; max-width: 760px; }
  .technology-list { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 24px 0 0; }
  .technology-list li { border: 1px solid var(--line); border-radius: 5px; padding: 5px 9px; font-size: 0.8rem; color: var(--muted); }
  .project-layout { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 56px; align-items: start; }
  .prose { min-width: 0; }
  .prose :global(h2) { font-size: clamp(1.35rem, 2.5vw, 1.55rem); letter-spacing: -0.035em; margin: 2.2em 0 0.65em; }
  .prose :global(p), .prose :global(li) { color: var(--muted); line-height: 1.85; }
  .prose :global(a) { color: var(--ink); text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .resource-panel { border-top: 2px solid var(--accent); padding-top: 14px; }
  .resource-panel h2 { font-size: 1rem; margin: 0 0 12px; }
  .resource-panel ul { list-style: none; margin: 0; padding: 0; }
  .resource-panel li { padding: 11px 0; border-bottom: 1px solid var(--line); font-size: 0.9rem; }
  .resource-panel a { color: var(--ink); text-decoration: none; }
  .resource-panel a:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 700px) { .project-layout { grid-template-columns: 1fr; gap: 30px; } .resource-panel { order: -1; } }
</style>
