---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  loading?: 'eager' | 'lazy';
  className?: string;
}

const { src, alt, loading = 'lazy', className = '' } = Astro.props;
---

<div class:list={['thumbnail-frame', className]}>
  <Image src={src} alt={alt} loading={loading} />
</div>

<style>
  .thumbnail-frame {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 7px;
  }

  .thumbnail-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
