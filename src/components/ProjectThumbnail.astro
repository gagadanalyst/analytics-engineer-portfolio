---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  darkSrc?: ImageMetadata;
  alt: string;
  loading?: 'eager' | 'lazy';
  className?: string;
}

const { src, darkSrc, alt, loading = 'lazy', className = '' } = Astro.props;
---

<div class:list={['thumbnail-frame', className, { 'has-dark-thumbnail': Boolean(darkSrc) }] }>
  <Image src={src} alt={alt} loading={loading} class="thumbnail-light" />
  {darkSrc && (
    <Image src={darkSrc} alt="" aria-hidden="true" loading={loading} class="thumbnail-dark" />
  )}
</div>

<style>
  .thumbnail-frame {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 7px;
  }

  .thumbnail-frame :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail-frame :global(img.thumbnail-dark) {
    display: none;
  }

  :global(html[data-theme="dark"]) .thumbnail-frame.has-dark-thumbnail :global(img.thumbnail-light) {
    display: none;
  }

  :global(html[data-theme="dark"]) .thumbnail-frame.has-dark-thumbnail :global(img.thumbnail-dark) {
    display: block;
  }
</style>
